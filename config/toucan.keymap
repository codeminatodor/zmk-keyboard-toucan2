#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define MAIN 0
#define NAV  1
#define NUM  2
#define FUN  3
#define MOU  4
#define SYS  5

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        // tri_layer {
        //     if-layers = <1 2>;
        //     then-layer = <3>;
        // };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "MAIN";
            bindings = <
                &lt NUM ESC    &kp Q &kp W &kp E &kp R &kp T      &kp Y &kp U  &kp I         &kp O    &kp P     &kp MINUS
                &kp LG(SPACE)  &kp A &kp S &kp D &kp F &kp G      &kp H &kp J  &kp K         &kp L    &kp SEMI  &kp DQT
                &kp TAB        &kp Z &kp X &kp C &kp V &kp B      &kp N &kp M  &kp COMMA     &kp DOT  &kp FSLH  &kp GRAVE
                               &kp LSHFT   &kp LCTRL   &kp SPACE  &lt NAV RET   &kp BSPC &lt SYS LBRC
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
                &none &none &none &none &none &none      &kp C_VOL_UP  &kp HOME    &kp UP     &kp END    &none &none
                &none &none &none &none &none &none      &kp C_VOL_DN  &kp LEFT    &kp DOWN   &kp RIGHT  &none &none
                &none &none &none &none &none &none      &kp C_MUTE    &kp PG_UP   &kp INS    &kp PG_DN  &none &kp PSCRN
                                  &trans &trans &trans   &none         &kp DEL     &none
            >;
        };

        num {
            display-name = "num";
            bindings = <
                &none &kp LALT &none &none &kp FSLH &kp LBKT      &kp RBKT     &kp N7  &kp N8  &kp N9  &kp N0  &kp EQUAL
                &none &none    &none &none &kp BSLH &kp LBRC      &kp RBRC     &kp N4  &kp N5  &kp N6  &none   &kp FSLH
                &none &none    &none &none &kp PIPE &uc 0x00AB 0  &uc 0x00BB 0 &kp N1  &kp N2  &kp N3  &kp DOT &kp COMMA
                               &trans &trans &trans               &none        &none   &kp N0
            >;
        };

        fun {
            display-name = "funct";
            bindings = <
                &none &none &none &none &none &none   &none &kp DEL &kp LCTRL &kp LALT &kp RSHFT &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                                  &none &none &none   &none &kp LGUI &kp K_APP
            >;
        };

        mouse {
            display-name = "MOUSE";
            bindings = <
            &trans &trans &trans    &trans    &trans &trans                   &msc SCRL_UP &trans &trans    &trans &trans &trans
            &trans &trans &trans    &trans    &trans &trans                   &msc SCRL_DOWN MCLK &trans    &trans &trans &trans &trans
            &trans &trans &trans    &trans    &msc SCRL_LEFT &msc SCRL_RIGHT  &mkp RCLK           &trans    &trans &trans &trans &trans
                          &mkp MCLK &mkp LCLK &mkp RCLK                       &mkp LCLK           &mkp RCLK &mkp MCLK
            >;
        };

        sys {
            display-name = "system";
            bindings = <
                &bt BT_CLR      &bt BT_SEL  0  &bt BT_SEL  1 &bt BT_SEL  2 &bt BT_SEL  3 &bt BT_SEL  4   &none &none &none &none &none &none
                &bt BT_CLR_ALL  &bt BT_DISC 0  &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4   &none &none &none &none &none &none
                &studio_unlock  &out OUT_TOG   &none         &none         &none         &bootloader     &bootloader &none &none &none &none &none
                                               &none &none   &none                                    &none &none &none
            >;
        };

        /*

            &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                            &trans &trans &trans         &trans &trans &trans
        
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                            &none &none &none   &none &none &none

        */

        // nav {
        //     display-name = "NAV";
        //     bindings = <
        //         &kp TAB     &kp N1          &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
        //         &bt BT_CLR  &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
        //         &kp LSHFT   &studio_unlock  &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
        //                                         &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
        //     >;
        // };

        // sym {
        //     display-name = "SYM";
        //     bindings = <
        //         &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
        //         &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
        //         &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
        //                                   &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
        //     >;
        // };

        // adj {
        //     display-name = "ADJ";
        //     bindings = <
        //         &mo TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &kp BSPC
        //         &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11   &trans       &trans      &trans       &trans &trans &trans
        //         &bt LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans      &trans       &trans &trans &trans
        //                            &kp LGUI &mo NAV &kp SPACE   &kp RET &mo 2 &kp RALT
        //     >;
        // };

        // mouse {
        //     display-name = "MOUSE";
        //     bindings = <
        //         &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
        //         &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
        //         &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
        //                     &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
        //     >;
        // };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
