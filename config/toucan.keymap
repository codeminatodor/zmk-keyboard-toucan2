#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define MAIN 0
#define NAV  1
#define NUM  2
#define FUN  3
#define MOU  4
#define SYS  5

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "MAIN";
            bindings = <
                &lt NUM ESC    &kp Q &kp W &kp E &kp R &kp T    &kp Y &kp U  &kp I         &kp O   &kp P     &kp MINUS
                &kp TAB        &kp A &kp S &kp D &kp F &kp G    &kp H &kp J  &kp K         &kp L   &kp SEMI  &kp DQT
                &kp LG(SPACE)  &kp Z &kp X &kp C &kp V &kp B    &kp N &kp M  &kp COMMA     &kp DOT &kp FSLH  &kp GRAVE
                   &kp LSHFT &kp LCTRL &kp SPACE                &lt NAV RET  &kp BSPC &lt SYS LBRC
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
                &none &none &none &none &none &none     &kp C_VOL_UP  &kp HOME    &kp UP     &kp END    &none &none
                &none &none &none &none &none &none     &kp C_VOL_DN  &kp LEFT    &kp DOWN   &kp RIGHT  &none &none
                &none &none &none &none &none &none     &kp C_MUTE    &kp PG_UP   &kp INS    &kp PG_DN  &none &kp PSCRN
                                  &trans &trans &trans  &trans        &kp DEL     &none
            >;
        };

        num {
            display-name = "num";
            bindings = <
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                            &none &none &none   &none &none &none
            >;
        };

        fun {
            display-name = "funct";
            bindings = <
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                            &none &none &none   &none &none &none
            >;
        }; 

        sys {
            display-name = "system";
            bindings = <
                &none           &none         &none &none &none &none    &none &none &none &none &none &none
                &none           &none         &none &none &none &none    &none &none &none &none &none &none
                &studio_unlock  &out OUT_TOG  &none &none &none &none    &none &none &none &none &none &none
                                                    &none &none &none    &none &none &none
            >;
        };


        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
