#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define FUN  3
#define MOU  4
#define SYS  5

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &lt NUM ESC    &kp Q &kp W &kp E &kp R &kp T      &kp Y &kp U  &kp I         &kp O    &kp P     &kp MINUS
                &kp LG(SPACE)  &kp A &kp S &kp D &kp F &kp G      &kp H &kp J  &kp K         &kp L    &kp SEMI  &kp DQT
                &kp TAB        &kp Z &kp X &kp C &kp V &kp B      &kp N &kp M  &kp COMMA     &kp DOT  &kp FSLH  &kp GRAVE
                               &kp LSHFT   &kp LCTRL   &kp SPACE  &lt NAV RET   &kp BSPC &lt SYS LBRC
            >;
        };

        num {
            display-name = "nav";
            bindings = <
                &none &kp LALT &none &none &kp FSLH &kp LBKT      &kp RBKT     &kp N7  &kp N8  &kp N9  &kp N0  &kp EQUAL
                &none &none    &none &none &kp BSLH &kp LBRC      &kp RBRC     &kp N4  &kp N5  &kp N6  &none   &kp FSLH
                &none &none    &none &none &kp PIPE &none  &none &kp N1  &kp N2  &kp N3  &kp DOT &kp COMMA
                               &trans &trans &trans               &none        &none   &kp N0
            >;
        };

        sym {
            display-name = "num";
            bindings = <
                &none &kp LALT &none &none &kp FSLH &kp LBKT      &kp RBKT     &kp N7  &kp N8  &kp N9  &kp N0  &kp EQUAL
                &none &none    &none &none &kp BSLH &kp LBRC      &kp RBRC     &kp N4  &kp N5  &kp N6  &none   &kp FSLH
                &none &none    &none &none &kp PIPE &uc 0x00AB 0  &uc 0x00BB 0 &kp N1  &kp N2  &kp N3  &kp DOT &kp COMMA
                               &trans &trans &trans               &none        &none   &kp N0
            >;
        };

        fun {
            display-name = "funct";
            bindings = <
                &none &none &none &none &none &none   &none &kp DEL &kp LCTRL &kp LALT &kp RSHFT &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                &none &none &none &none &none &none   &none &none &none &none &none &none
                                  &none &none &none   &none &kp LGUI &kp K_APP
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        sys {
            display-name = "system";
            bindings = <
                &bt BT_CLR      &bt BT_SEL  0  &bt BT_SEL  1 &bt BT_SEL  2 &bt BT_SEL  3 &bt BT_SEL  4   &none &none &none &none &none &none
                &bt BT_CLR_ALL  &bt BT_DISC 0  &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4   &none &none &none &none &none &none
                &studio_unlock  &out OUT_TOG   &none         &none         &none         &bootloader     &bootloader &none &none &none &none &none
                                               &none &none   &none                                    &none &none &none
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
