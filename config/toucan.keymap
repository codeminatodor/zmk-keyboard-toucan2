#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define MAIN 0
#define NAVI 1
#define NUMB 2
#define FUNC 3
#define MOUS 4
#define SYST 5

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        // tri_layer {
        //     if-layers = <1 2>;
        //     then-layer = <3>;
        // };
    };

    macros {
        quote_left: quote_left {
            label = "QUOTE_LEFT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N1>
                , <&macro_release &kp LALT>;
        };

        quote_right: quote_right {
            label = "QUOTE_RIGHT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N8 &kp KP_N7>
                , <&macro_release &kp LALT>;
        };
    };

behaviors {
        // Тап-данс: 1 нажатие = обычный BSPC, 2 нажатия (и удержание после) = зажатый BSPC
        td_bspc: td_bspc {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp BSPC>, <&kp BSPC>;
        };

        // Hold-tap — тап вызывает td_bspc, долгое нажатие держит слой NUMB
        hm_bspc: hm_bspc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&td_bspc>;
        };
    };
 
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "MAIN";
            bindings = <
                &lt NUMB ESC   &kp Q  &kp W  &kp E     &kp R     &kp T        &kp Y &kp U   &kp I          &kp O    &kp P     &lt FUNC MINUS
                &kp LG(SPACE)  &kp A  &kp S  &kp D     &kp F     &kp G        &kp H &kp J   &kp K          &kp L    &kp SEMI  &kp SQT
                &lt FUNC TAB   &kp Z  &kp X  &kp C     &kp V     &kp B        &kp N &kp M   &kp COMMA      &kp DOT  &kp FSLH  &mt LALT GRAVE
                                             &kp LSHFT &kp LCTRL &kp SPACE    &lt NAVI RET  &hm_bspc NUMB 0  &lt SYST LBKT
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
                &none &none &none &none &none &kp C_BRI_UP      &kp C_VOL_UP  &kp HOME   &kp UP     &kp END    &none &none
                &none &none &none &none &none &kp C_BRI_DN      &kp C_VOL_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &none &kp SLCK
                &none &none &none &none &none &none             &kp C_MUTE    &kp PG_UP  &kp INS    &kp PG_DN  &none &kp PSCRN
                                  &trans &trans &trans          &none         &kp DEL    &kp LBKT
            >;
        };

        num {
            display-name = "num";
            bindings = <
                &none &kp LALT &none  &none        &kp FSLH      &kp LBKT        &kp RBKT     &kp N7   &kp N8  &kp N9  &kp N0   &kp EQUAL
                &none &none    &none  &none        &kp BSLH      &kp LBRC        &kp RBRC     &kp N4   &kp N5  &kp N6  &kp BSLH &kp FSLH
                &none &none    &none  &quote_left  &quote_right  &kp LPAR        &kp RPAR  &kp N1   &kp N2  &kp N3  &kp DOT  &kp COMMA
                               &trans &trans &trans                              &kp BSPC     &none    &kp N0
            >;
        };
 
        fun {
            display-name = "funct";
            bindings = <
            &mo TAB   &trans &kp F7 &kp F8 &kp F9 &kp F10      &none    &none     &kp LCTRL  &kp RALT   &kp LSHFT  &none
            &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11      &none    &none     &none      &none      &none      &none
            &none     &trans &kp F1 &kp F2 &kp F3 &kp F12      &none    &none     &none      &none      &none      &none
                             &kp LSHFT &kp LCTRL  &kp SPACE    &kp RET  &kp LGUI  &kp K_APP
            >;
        };
 
        mouse {
            display-name = "MOUSE";
            bindings = <
            &trans &trans &trans    &trans    &trans &trans     &msc SCRL_UP    &trans     &trans    &trans &trans &trans
            &trans &trans &trans    &trans    &trans &trans     &msc SCRL_DOWN  &trans     &trans    &trans &trans &trans
            &trans &trans &trans    &trans    &msc SCRL_LEFT    &msc SCRL_RIGHT &mkp RCLK  &trans    &trans &trans &trans &trans
                          &mkp MCLK &mkp LCLK &mkp RCLK         &mkp LCLK       &mkp RCLK  &mkp MCLK
            >;
        };

        sys {
            display-name = "syst";
            bindings = <
                &bt BT_CLR      &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none &none &none &none &none &none
                &bt BT_CLR_ALL  &bt BT_DISC 0  &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4   &none &none &none &none &none &none
                &studio_unlock  &out OUT_TOG   &none         &none         &none         &bootloader     &bootloader &none &none &none &none &none
                                               &none &none   &none                                       &none &none &none
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
