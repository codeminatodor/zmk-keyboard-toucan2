#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define MAIN 0
#define NAVI 1
#define NUMB 2
#define FUNC 3
#define MOUS 4
#define SYST 5

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        // tri_layer {
        //     if-layers = <1 2>;
        //     then-layer = <3>;
        // };
    };
 
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "MAIN";
            bindings = <
                &lt NUMB ESC   &kp Q  &kp W  &kp E     &kp R     &kp T        &kp Y &kp U   &kp I        &kp O    &kp P     &lt FUNC MINUS
                &kp LG(SPACE)  &kp A  &kp S  &kp D     &kp F     &kp G        &kp H &kp J   &kp K        &kp L    &kp SEMI  &kp SQT
                &lt FUNC TAB   &kp Z  &kp X  &kp C     &kp V     &kp B        &kp N &kp M   &kp COMMA    &kp DOT  &kp FSLH  &kp GRAVE
                                      &kp LSHFT  &kp LCTRL &kp SPACE          &lt NAVI RET  &lt NUMB BSPC  &lt SYST LBRC
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
                &none &none &none &none &none &kp C_BRI_UP      &kp C_VOL_UP  &kp HOME    &kp UP     &kp END    &none &none
                &none &none &none &none &none &kp C_BRI_DN      &kp C_VOL_DN  &kp LEFT    &kp DOWN   &kp RIGHT  &none &none
                &none &none &none &none &none &none      &kp C_MUTE    &kp PG_UP   &kp INS    &kp PG_DN  &none &kp PSCRN
                                  &trans &trans &trans   &none         &kp DEL     &none
            >;
        };

        num {
            display-name = "num";
            bindings = <
                &none &kp LALT &none  &none  &kp FSLH &kp LBKT      &kp RBKT     &kp N7     &kp N8  &kp N9  &kp N0  &kp EQUAL
                &none &none    &none  &none  &kp BSLH &kp LBRC      &kp RBRC     &kp N4     &kp N5  &kp N6  &none   &kp FSLH
                &none &none    &none  &none  &kp PIPE &kp LS(N9)    &kp LS(N0)   &kp N1 &kp N2     &kp N3  &kp DOT &kp COMMA
                               &trans &trans &trans                 &none        &none   &kp N0
            >;
        };
 
        fun {
            display-name = "funct";
            bindings = <
            &mo TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12    &none    &none    &kp LCTRL &kp RALT  &kp LSHFT &none
            &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11    &none    &none    &none     &none      &none     &none
            &none     &trans &kp F1 &kp F2 &kp F3 &kp F10    &none    &none    &none     &none      &none     &none
                             &kp LSHFT &kp LCTRL  &kp SPACE   &kp RET  &kp LGUI &kp RALT
            >;
        };
 
        mouse {
            display-name = "MOUSE";
            bindings = <
            &trans &trans &trans    &trans    &trans &trans                   &msc SCRL_UP   &trans    &trans    &trans &trans &trans
            &trans &trans &trans    &trans    &trans &trans                   &msc SCRL_DOWN &trans    &trans &trans &trans &trans
            &trans &trans &trans    &trans    &msc SCRL_LEFT &msc SCRL_RIGHT  &mkp RCLK      &trans    &trans &trans &trans &trans
                          &mkp MCLK &mkp LCLK &mkp RCLK                       &mkp LCLK      &mkp RCLK  &mkp MCLK
            >;
        };

        sys {
            display-name = "syst";
            bindings = <
                &bt BT_CLR      &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4   &none &none &none &none &none &none
                &bt BT_CLR_ALL  &bt BT_DISC 0  &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4   &none &none &none &none &none &none
                &studio_unlock  &out OUT_TOG   &none         &none         &none         &bootloader     &bootloader &none &none &none &none &none
                                               &none &none   &none                                    &none &none &none
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
